{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ipv6.json",
      "destination": "/api/manage?format=json"
    },
    {
      "source": "/ipv6.m3u",
      "destination": "/api/m3u"
    },
    {
      "source": "/ipv6.txt",
      "destination": "/api/txt"
    },
    {
      "source": "/",
      "destination": "/api/manage"
    },
    {
      "source": "/:token/ipv6.m3u",
      "destination": "/api/m3u?token=:token"
    },
    {
      "source": "/:token/ipv6.txt",
      "destination": "/api/txt?token=:token"
    },
    {
      "source": "/:token",
      "destination": "/api/manage?token=:token"
    }
  ]
}
